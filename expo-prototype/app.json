{
  "expo": {
    "name": "農作業レポート",
    "slug": "farm-app-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F6",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F6"
    },
    "ios": {
      "bundleIdentifier": "com.kishufarm.farmreport",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "作業記録に添付する写真を選択するために使用します",
        "NSCameraUsageDescription": "作業記録に添付する写真を撮影するために使用します",
        "NSLocationWhenInUseUsageDescription": "圃場の位置を現在地から設定するために使用します",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kishufarm.farmreport",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ]
    ]
  }
}
